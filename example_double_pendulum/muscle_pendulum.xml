<mujoco model="double_pendulum_muscle">
  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.002" gravity="0 0 9.81" integrator="RK4"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.2 0.2 0.2" specular="0 0 0"/>
  </visual>

  <default>
    <joint limited="false" damping="0.10"/>
    <geom type="capsule" friction="1 0.1 0.1" density="800"/>
  </default>

  <worldbody>
    <light pos="0 0 3"/>
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.92 0.92 0.92 1"/>
    <camera name="main" pos="2.2 -2.2 1.8" xyaxes="0.7 0.7 0  -0.3 0.3 0.9"/>

    <body name="base" pos="0 0 2.5">
      <site name="pivot" pos="0 0 0" size="0.01" rgba="0 0 0 1"/>
      <!-- Attachment site on the fixed base (for hinge1 muscle). -->
      <site name="m1_base" pos="0.03 0 0.0" size="0.006" rgba="0 0 0 1"/>

      <body name="link1">
        <joint name="hinge1" type="hinge" axis="0 2 0"/>
        <geom name="rod1" fromto="0 0 0  0 0 -0.6" size="0.04" rgba="0.2 0.5 0.8 1"/>

        <!-- Attachment sites for a simple 1-DOF muscle across hinge1 -->
        <site name="m1_link1" pos="0.03 0 -0.22" size="0.006" rgba="0 0 0 1"/>

        <!-- Attachment site on link1 near the elbow (for hinge2 muscle). -->
        <site name="m2_link1" pos="0.03 0 -0.60" size="0.006" rgba="0 0 0 1"/>

        <body name="link2" pos="0 0 -0.6">
          <joint name="hinge2" type="hinge" axis="0 2 0"/>
          <geom name="rod2" fromto="0 0 0  0 0 -0.6" size="0.04" rgba="0.8 0.4 0.2 1"/>

          <!-- Attachment sites for a simple 1-DOF muscle across hinge2 -->
          <site name="m2_link2" pos="0.03 0 -0.22" size="0.006" rgba="0 0 0 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <tendon>
    <!-- Minimal spatial tendons (straight line) spanning each hinge. -->
    <spatial name="tendon1" width="0.004" rgba="0.2 0.7 0.2 1">
      <site site="m1_base"/>
      <site site="m1_link1"/>
    </spatial>
    <spatial name="tendon2" width="0.004" rgba="0.2 0.7 0.2 1">
      <site site="m2_link1"/>
      <site site="m2_link2"/>
    </spatial>
  </tendon>

  <actuator>
    <!-- Simple muscle actuators; control in [0,1] is activation. -->
    <!-- Let MuJoCo derive a valid length range from the tendon and geometry. -->
    <muscle name="muscle1" tendon="tendon1" ctrlrange="0 1" timeconst="0.01 0.04"/>
    <muscle name="muscle2" tendon="tendon2" ctrlrange="0 1" timeconst="0.01 0.04"/>
  </actuator>
</mujoco>

