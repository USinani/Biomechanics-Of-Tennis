<?xml version="1.0" encoding="utf-8"?>
<!-- Double pendulum with a vertical slide DOF so pivot height is a controllable qpos (see sim_parameter_lab.py). -->
<mujoco model="double_pendulum_lab">
  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.2 0.2 0.2" specular="0 0 0"/>
  </visual>

  <default>
    <joint limited="true" damping="0.02"/>
    <geom type="capsule" friction="1 0.1 0.1" density="800"/>
  </default>

  <worldbody>
    <light pos="0 0 3"/>
    <geom name="ground" type="plane" size="2 2 0.1" rgba="0.92 0.92 0.92 1"/>
    <camera name="main" pos="2.2 -2.2 1.8" xyaxes="0.7 0.7 0  -0.3 0.3 0.9"/>

    <!-- Slide along Z sets pivot height (qpos in meters). -->
    <body name="tower" pos="0 0 0">
      <joint name="anchor_height" type="slide" axis="0 0 1" range="1.0 2.5" damping="0.12"/>
      <geom name="mast" type="cylinder" fromto="0 0 -0.05 0 0 0.05" size="0.035" rgba="0.35 0.35 0.4 1"/>

      <body name="base" pos="0 0 0">
        <site name="pivot" pos="0 0 0" size="0.012" rgba="0 0 0 1"/>

        <body name="link1">
          <joint name="hinge1" type="hinge" axis="0 1 0" limited="false" damping="0.01"/>
          <geom name="rod1" fromto="0 0 0  0 0 -0.6" size="0.04" rgba="0.2 0.5 0.8 1"/>

          <body name="link2" pos="0 0 -0.6">
            <joint name="hinge2" type="hinge" axis="0 1 0" limited="false" damping="0.01"/>
            <geom name="rod2" fromto="0 0 0  0 0 -0.6" size="0.04" rgba="0.8 0.4 0.2 1"/>
            <site name="tip" pos="0 0 -0.6" size="0.01" rgba="0 0 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
